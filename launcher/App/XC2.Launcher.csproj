<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <OutputType>WinExe</OutputType>
    <AssemblyName>Xenoblade2Launcher</AssemblyName>
    <RootNamespace>XC2.Launcher</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <NoWarn>$(NoWarn);MSB3277</NoWarn>
    <Version>0.2.3</Version>
    <Product>Xenoblade Chronicles 2: PC Edition Launcher</Product>
    <Deterministic>true</Deterministic>
    <PathMap>$(MSBuildProjectDirectory)=/src/launcher/App</PathMap>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon Condition="Exists('..\..\assets\visual_kit\01_atalhos\xc2_pc_cristal.ico')">..\..\assets\visual_kit\01_atalhos\xc2_pc_cristal.ico</ApplicationIcon>
    <ApplicationIcon Condition="'$(ApplicationIcon)' == '' and Exists('..\..\work\visual_identity_kit\v2_native\kit\01_atalhos\xc2_pc_cristal.ico')">..\..\work\visual_identity_kit\v2_native\kit\01_atalhos\xc2_pc_cristal.ico</ApplicationIcon>
  </PropertyGroup>

  <PropertyGroup Condition="'$(RuntimeIdentifier)' != ''">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <DebugType>none</DebugType>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Core\XC2.Core.csproj" />
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.3296.44" />
    <Reference Remove="Microsoft.Web.WebView2.WinForms" />
    <Reference Remove="Microsoft.Web.WebView2.Wpf" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\ui\**\*" LogicalName="ui/%(RecursiveDir)%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
